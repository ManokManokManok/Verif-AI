{
  "name": "verifai-contracts",
  "version": "1.0.0",
  "description": "Verif-AI Blockchain Smart Contracts",
  "main": "truffle-config.js",
  "scripts": {
    "compile": "truffle compile",
    "migrate": "truffle migrate --network ganache",
    "migrate:reset": "truffle migrate --reset --network ganache",
    "test": "truffle test --network ganache",
    "console": "truffle console --network ganache",
    "deploy": "npm run compile && npm run migrate",
    "extract-abi": "node scripts/extract-abi.js",
    "deploy:full": "npm run compile && npm run migrate && npm run extract-abi"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "blockchain",
    "verifai"
  ],
  "author": "Verif-AI Team",
  "license": "MIT",
  "devDependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "truffle": "^5.11.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1"
  }
}
