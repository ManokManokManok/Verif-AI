# =============================================================================
# VerfAi Backend Environment Configuration
# =============================================================================
# SECURITY WARNING: Copy this file to .env and set secure values
# NEVER commit .env to version control
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# SECURITY: Set to False in production
DJANGO_DEBUG=False

# REQUIRED in production: Comma-separated list of allowed hosts (no wildcards)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# =============================================================================
# DATABASE - MongoDB Atlas
# =============================================================================
# REQUIRED: MongoDB connection string
# Format: mongodb+srv://<username>:<password>@<cluster>/
MONGODB_URI=
MONGODB_DB_NAME=verfai

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECURITY: Must be at least 64 characters for production
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=900      # 15 minutes in seconds
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days in seconds

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Authentication endpoints (stricter limits)
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW=300       # 5 requests per 5 minutes
RATE_LIMIT_AUTH_LOGIN_BLOCK=900        # 15 minute block

RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
RATE_LIMIT_AUTH_REGISTER_WINDOW=3600   # 3 per hour
RATE_LIMIT_AUTH_REGISTER_BLOCK=3600

RATE_LIMIT_PASSWORD_RESET_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600  # 3 per hour
RATE_LIMIT_PASSWORD_RESET_BLOCK=3600

RATE_LIMIT_EMAIL_VERIFICATION_REQUESTS=5
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW=3600
RATE_LIMIT_EMAIL_VERIFICATION_BLOCK=1800

# General API endpoints
RATE_LIMIT_API_READ_REQUESTS=100
RATE_LIMIT_API_READ_WINDOW=60          # 100 per minute
RATE_LIMIT_API_READ_BLOCK=60

RATE_LIMIT_API_WRITE_REQUESTS=30
RATE_LIMIT_API_WRITE_WINDOW=60         # 30 per minute
RATE_LIMIT_API_WRITE_BLOCK=120

RATE_LIMIT_TOKEN_REFRESH_REQUESTS=10
RATE_LIMIT_TOKEN_REFRESH_WINDOW=60
RATE_LIMIT_TOKEN_REFRESH_BLOCK=300

RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_DEFAULT_BLOCK=60

# =============================================================================
# EMAIL CONFIGURATION (for production)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# =============================================================================
# REDIS CONFIGURATION (for token blacklisting in production)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Ganache for development)
# =============================================================================
# Enable/disable blockchain anchoring features
CHAIN_ENABLED=false

# Ganache RPC URL (default: http://127.0.0.1:7545)
CHAIN_RPC_URL=http://127.0.0.1:7545

# SECURITY: Private key for backend signer
# NEVER commit actual private keys - use dedicated accounts
# Generate a new key for production use only
CHAIN_PRIVATE_KEY=

# Deployed AnalysisAnchor contract address
CHAIN_CONTRACT_ADDRESS=

# Network identifier for documentation
CHAIN_NETWORK_NAME=ganache

# Optional: Gas limit for transactions (default: 500000)
CHAIN_GAS_LIMIT=500000