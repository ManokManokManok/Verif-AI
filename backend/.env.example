#GAYAHIN NYO TO MGA BUDDY (NASA MESSENGER ACTUAL VALUES)

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGODB_DB_NAME=verfai

# LLM Models (defaults work; override if needed)
LLM_MULTIHEAD_MODEL_ID=ManokManokManok/bimBert_Scam-Detection
LLM_GEMMA_MODEL_ID=lmstudio-community/gemma-3-4B-it-qat-GGUF
LLM_GGUF_FILENAME=gemma-3-4B-it-QAT-Q4_0.gguf

# Optional warm-up on server start (can be heavy)
LLM_WARMUP_ON_START=False
LLM_WARMUP_TARGETS=multihead,gemma