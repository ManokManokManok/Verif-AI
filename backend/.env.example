# =============================================================================
# VerfAi Backend Environment Configuration
# =============================================================================
# SECURITY WARNING: Copy this file to .env and set secure values
# NEVER commit .env to version control
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# SECURITY: Set to False in production
DJANGO_DEBUG=False

# REQUIRED in production: Comma-separated list of allowed hosts (no wildcards)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# =============================================================================
# DATABASE - MongoDB Atlas
# =============================================================================
# REQUIRED: MongoDB connection string
# Format: mongodb+srv://<username>:<password>@<cluster>/
# TLS is enforced automatically for remote connections (Atlas, cloud).
# To force TLS for local connections, set MONGODB_REQUIRE_TLS=true

# Primary connection (used as fallback if role-specific URIs not set)
MONGODB_URI=
MONGODB_DB_NAME=verfai
MONGODB_REQUIRE_TLS=true  # Uncomment to enforce TLS even for localhost

# =============================================================================
# ROLE-BASED ACCESS CONTROL (Least Privilege Principle)
# =============================================================================
# For production security, create separate MongoDB Atlas users with different permissions:
# 
# 1. Backend User (readWrite on verfai database)
#    - Used by: Main application for all read/write operations
#    - Permissions: readWrite role on 'verfai' database
#    - Usage: Default for most application operations
#
# 2. Analytics User (read on verfai database)  
#    - Used by: Reporting, dashboards, analytics queries
#    - Permissions: read role on 'verfai' database (no write access)
#    - Usage: get_mongo_client(role='analytics')
#
# 3. Admin User (dbAdmin on verfai database)
#    - Used by: Database migrations, schema changes, maintenance scripts
#    - Permissions: dbAdmin role on 'verfai' database
#    - Usage: get_mongo_client(role='admin')
#
# If these are not set, MONGODB_URI is used as fallback (backward compatible)
# See backend/docs/MONGODB_SETUP.md for setup instructions

# MONGODB_URI_BACKEND=mongodb+srv://backend-user:password@cluster.mongodb.net/
# MONGODB_URI_ANALYTICS=mongodb+srv://analytics-user:password@cluster.mongodb.net/
# MONGODB_URI_ADMIN=mongodb+srv://admin-user:password@cluster.mongodb.net/

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECURITY: Must be at least 64 characters for production
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=900      # 15 minutes in seconds
JWT_REFRESH_TOKEN_LIFETIME=5     # 604800 7 days in seconds

# =============================================================================
# LLM MODEL CONFIGURATION
# =============================================================================
LLM_MULTIHEAD_MODEL_ID=ManokManokManok/bimBert_Scam-Detection
# Optional: set to mk5 or mk4 when model files are inside a repo subfolder.
# Leave empty to auto-try repo root, mk5, then mk4.
LLM_MULTIHEAD_SUBFOLDER=
LLM_GEMMA_MODEL_ID=lmstudio-community/gemma-3-4B-it-qat-GGUF
LLM_GGUF_FILENAME=gemma-3-4B-it-QAT-Q4_0.gguf

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Authentication endpoints (stricter limits)
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW=300       # 5 requests per 5 minutes
RATE_LIMIT_AUTH_LOGIN_BLOCK=900        # 15 minute block

RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
RATE_LIMIT_AUTH_REGISTER_WINDOW=3600   # 3 per hour
RATE_LIMIT_AUTH_REGISTER_BLOCK=3600

RATE_LIMIT_PASSWORD_RESET_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600  # 3 per hour
RATE_LIMIT_PASSWORD_RESET_BLOCK=3600

RATE_LIMIT_EMAIL_VERIFICATION_REQUESTS=5
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW=3600
RATE_LIMIT_EMAIL_VERIFICATION_BLOCK=1800

# General API endpoints
RATE_LIMIT_API_READ_REQUESTS=100
RATE_LIMIT_API_READ_WINDOW=60          # 100 per minute
RATE_LIMIT_API_READ_BLOCK=60

RATE_LIMIT_API_WRITE_REQUESTS=30
RATE_LIMIT_API_WRITE_WINDOW=60         # 30 per minute
RATE_LIMIT_API_WRITE_BLOCK=120

RATE_LIMIT_TOKEN_REFRESH_REQUESTS=10
RATE_LIMIT_TOKEN_REFRESH_WINDOW=60
RATE_LIMIT_TOKEN_REFRESH_BLOCK=300

RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_DEFAULT_BLOCK=60

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Backend selection: sendgrid | nodemailer | smtp | mock (default: mock)
# Use 'mock' for local development (emails print to console)
EMAIL_BACKEND=sendgrid

# SendGrid (for production) ---
# Sign up at https://sendgrid.com → Settings → API Keys → Create API Key
SENDGRID_API_KEY=

# --- Option 1b: Nodemailer bridge (Node.js) ---
# 1) cd backend && npm install
# 2) Set EMAIL_BACKEND=nodemailer
# 3) Configure SMTP transport below (NODEMAILER_* or EMAIL_HOST_* fallbacks)
# EMAIL_BACKEND=nodemailer
NODE_EXECUTABLE=node
NODEMAILER_SCRIPT_PATH=
NODEMAILER_TIMEOUT_SECONDS=15
NODEMAILER_HOST=
NODEMAILER_PORT=587
NODEMAILER_SECURE=False
NODEMAILER_USER=
NODEMAILER_PASS=

# --- Option 2: SMTP (Gmail, Outlook, etc.) ---
# EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Sender identity (used by all backends)
EMAIL_FROM_ADDRESS=noreply@verfai.com   
EMAIL_FROM_NAME=Verif-AI

# Frontend URL for email links (verification, password reset)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# MFA CONFIGURATION
# =============================================================================
# Enable/disable Multi-Factor Authentication
# Set to False in development to bypass OTP verification and use any 6-digit code
# SECURITY: Always set to True in production
MFA_ENABLED=True

# =============================================================================
# MFA RATE LIMITING
# =============================================================================
RATE_LIMIT_MFA_SEND_REQUESTS=3
RATE_LIMIT_MFA_SEND_WINDOW=300         # 3 per 5 minutes
RATE_LIMIT_MFA_SEND_BLOCK=600

RATE_LIMIT_MFA_VERIFY_REQUESTS=5
RATE_LIMIT_MFA_VERIFY_WINDOW=300       # 5 per 5 minutes
RATE_LIMIT_MFA_VERIFY_BLOCK=900

# =============================================================================
# REDIS CONFIGURATION (for token blacklisting in production)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

